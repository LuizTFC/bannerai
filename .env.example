# ──────────────────────────────────────────────────────────────────────────────
# Bannerai — environment configuration
# Copy this file to `.env` at the repository root. Both apps and Docker Compose
# read from it. Never commit `.env`.
# ──────────────────────────────────────────────────────────────────────────────

# Frontend (Next.js) — only NEXT_PUBLIC_* variables are exposed to the browser
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Backend (Express)
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
# Public URL of the backend itself (used to build the Google OAuth callback URL)
API_PUBLIC_URL=http://localhost:4000
LOG_LEVEL=info

# Database (Docker Compose uses POSTGRES_* to start the container; the API uses DATABASE_URL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bannerai
POSTGRES_PORT=5432
# Docker image for the database container
POSTGRES_IMAGE=postgres:17-alpine
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bannerai

# Authentication — Google OAuth 2.0 (see README → Google OAuth configuration)
# Authorized redirect URI: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random string with at least 32 characters (e.g. `openssl rand -base64 48`)
SESSION_SECRET=
# Session lifetime in hours (default 168 = 7 days)
SESSION_TTL_HOURS=168
# Optional: restrict sign-in to these email domains (comma separated), e.g. "mychurch.org"
ALLOWED_EMAIL_DOMAINS=

# AI providers (at least one is required to generate banners)
GEMINI_API_KEY=
OPENAI_API_KEY=

# AI configuration
# Image provider used for every generation (the UI does not expose a choice): openai | gemini
# OpenAI (GPT Image 2.5 Sunburst) produced clearly better on-brand results in testing; Gemini stays
# available as a fallback text model for prompt optimization and brand analysis.
DEFAULT_AI_PROVIDER=openai
# Image models (defaults shown; leave empty to use the defaults)
GEMINI_IMAGE_MODEL=gemini-3-pro-image
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
# Gemini output resolution: 1K | 2K | 4K (2K recommended; 1K gets upscaled to the final canvas)
GEMINI_IMAGE_SIZE=2K
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# OpenAI render quality: low | medium | high | xhigh | auto
OPENAI_IMAGE_QUALITY=high
OPENAI_TEXT_MODEL=gpt-5-mini
# Legacy alias kept for compatibility: overrides the default provider's image model
DEFAULT_IMAGE_MODEL=
# Whether to run the prompt-optimization text model before image generation (true | false)
ENABLE_PROMPT_OPTIMIZATION=true

# Storage: local (development) or r2 (Cloudflare R2, production)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
# Max upload size per file in MB
MAX_UPLOAD_SIZE_MB=10
# Cloudflare R2 (required when STORAGE_PROVIDER=r2). Create an API token with Object Read & Write on the bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=bannerai
R2_SIGNED_URL_TTL_SECONDS=3600

# Jobs: pgboss (durable PostgreSQL queue, default) or memory (single process)
QUEUE_DRIVER=pgboss

# Face detector for "exact faces" (elementRendering=exact): human (bundled models, TensorFlow.js WASM) or none (faces stay as painted)
FACE_LOCK_PROVIDER=human
# true = this API process also consumes jobs (development). In production set false and run workers (`npm run start:worker`).
RUN_WORKER=true
# Parallel generations per worker process
WORKER_CONCURRENCY=2
GENERATION_TIMEOUT_SECONDS=600

# Credits & payments (credits only, no subscriptions)
# 1 credit ≈ R$ 0.50 · generation = 3 credits · edit = 2 credits · free trial on first login
CREDIT_COST_GENERATION=3
CREDIT_COST_EDIT=2
TRIAL_CREDITS=10
# Stripe: https://dashboard.stripe.com/apikeys and the webhook signing secret for POST /api/billing/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
